{
  "name": "impactx-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Impact X UI — multi-DS, multi-theme component library distributed via @impactx/ui CLI",
  "scripts": {
    "dev": "turbo dev",
    "kill": "lsof -ti:3002 | xargs -r kill -9",
    "build": "turbo build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "registry:build": "node scripts/build-registry.mjs",
    "tokens:build": "pnpm --filter @impactxlab/tokens build",
    "tokens:check": "node scripts/check-tokens-parity.mjs",
    "rules:check": "node scripts/check-rules.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.0.0",
    "next": "16.2.4",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
