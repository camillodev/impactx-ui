{
  "name": "@impactx/ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Impact X UI — multi-DS, multi-theme component CLI",
  "bin": { "@impactx/ui": "./bin/cli.mjs" },
  "files": ["bin", "dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "ohash": "^1.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^2.0.0"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
