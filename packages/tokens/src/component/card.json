          "$value": "{shadow.card-subtle}",
          "$type": "shadow"
        },
        "default": {
          "$value": "{shadow.card-default}",
          "$type": "shadow"
        },
        "hover": {
          "$value": "{shadow.card-hover}",
          "$type": "shadow"
        }
      },
      "border": {
