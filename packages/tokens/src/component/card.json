          "$value": "{color.border-input}",
          "$type": "color"
        },
        "color-active": {
          "$value": "{color.primary}",
          "$type": "color"
        },
        "width": {
          "$value": "1px",
          "$type": "dimension"
        },
        "width-active": {
          "$value": "2px",
          "$type": "dimension"
        }
