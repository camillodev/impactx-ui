{
  "name": "@impactxlab/design-system",
  "version": "2.0.0",
  "description": "Impact X UI — React component library + tokens (Education / Kumon / Impact X themes)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens/base.css": "./dist/tokens/base.css",
    "./tokens/themes/education.css": "./dist/tokens/themes/education.css",
    "./tokens/themes/kumon.css": "./dist/tokens/themes/kumon.css",
    "./tokens/themes/impactx.css": "./dist/tokens/themes/impactx.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    ".impactx",
    "AGENTS.md",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/verify-build.mjs",
    "clean": "node -e \"import('node:fs/promises').then(fs => Promise.all([fs.rm('dist', { recursive: true, force: true }), fs.rm('tsconfig.tsbuildinfo', { force: true })]))\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camillodev/impactx-ui.git",
    "directory": "packages/ds-education"
  },
  "peerDependencies": {
    "@impactxlab/tokens": "^1.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "imask": "^7.6.1",
    "lucide-react": "^1.11.0",
    "radix-ui": "^1.4.3",
    "react-imask": "^7.6.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@impactxlab/tokens": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
